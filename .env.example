# Meta Model API key (developer.meta.com). Without it, Consumed runs in demo mode at no cost.
META_API_KEY=
# Live calls are off unless this is 1 and a budget is set.
CONSUMED_LIVE=0
# Hard cap in US dollars for all Meta Model API calls; the spend guard refuses anything past it.
CONSUMED_BUDGET_USD=0
# Per-visitor allowance for a public deployment.
CONSUMED_IDENTIFY_PER_HOUR=40
CONSUMED_CARDS_PER_HOUR=4
CONSUMED_PAINTS_PER_HOUR=30
CONSUMED_CUTOUTS_PER_HOUR=40
