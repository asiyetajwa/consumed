{
  "name": "consumed",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Consumed: one daily page of what you listened to, read and ate, as stickers your friends can react to today. Muse Spark reads, Muse Image paints.",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "start": "npm run build && tsx --env-file-if-exists=.env src/server/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
